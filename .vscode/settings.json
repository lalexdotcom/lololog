{
	"js/ts.tsserver.experimental.enableProjectDiagnostics": true,
	"js/ts.preferences.useAliasesForRenames": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"editor.formatOnSave": true,
	// Declared per language rather than as `editor.defaultFormatter`: Biome only
	// handles the languages below, and a global default makes every save of a
	// Markdown, YAML or shell file raise "configured as formatter but it cannot
	// format". With no default, those files simply keep whatever formatter their
	// own extension provides, or none.
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[graphql]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"files.associations": {
		"*.css": "css"
	},
	"files.watcherExclude": {
		"**/dist/**": true,
		"**/node_modules/**": true
	},
	"search.exclude": {
		"**/dist": true,
		"**/node_modules": true
	},
	"workbench.colorCustomizations": {
		"activityBar.activeBackground": "#ff6433",
		"activityBar.activeBorder": "#15202b",
		"activityBar.background": "#ff6433",
		"activityBar.foreground": "#15202b",
		"activityBar.inactiveForeground": "#15202b99",
		"activityBarBadge.background": "#00ff3d",
		"activityBarBadge.foreground": "#15202b",
		"activityBarTop.activeBackground": "#ff6433",
		"activityBarTop.activeBorder": "#15202b",
		"activityBarTop.background": "#ff6433",
		"activityBarTop.foreground": "#15202b",
		"activityBarTop.inactiveForeground": "#15202b99",
		"commandCenter.border": "#e7e7e799",
		"commandCenter.foreground": "#e7e7e7",
		"sash.hoverBorder": "#ff6433",
		"statusBar.background": "#ff3d00",
		"statusBar.debuggingBackground": "#ff3d00",
		"statusBar.debuggingForeground": "#e7e7e7",
		"statusBar.foreground": "#e7e7e7",
		"statusBarItem.hoverBackground": "#ff6433",
		"statusBarItem.remoteBackground": "#006017",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"titleBar.activeBackground": "#ff3d00",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveBackground": "#ff3d0099",
		"titleBar.inactiveForeground": "#e7e7e799"
	},
	"peacock.remoteColor": "#ff3d00"
}
